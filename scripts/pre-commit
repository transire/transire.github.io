#!/bin/bash
# Pre-commit hook for transire.github.io documentation
# This runs the same checks as CI to catch issues early

set -e

echo "🔍 Running pre-commit checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to print colored output
print_status() {
    if [ $1 -eq 0 ]; then
        echo -e "${GREEN}✓${NC} $2"
    else
        echo -e "${RED}✗${NC} $2"
    fi
}

# Check if Python is available
if ! command -v python3 &> /dev/null; then
    echo -e "${RED}✗ Python 3 is required but not installed${NC}"
    exit 1
fi

# Check if pip is available
if ! command -v pip3 &> /dev/null; then
    echo -e "${RED}✗ pip3 is required but not installed${NC}"
    exit 1
fi

# Install dependencies if not present
echo "📦 Checking dependencies..."
pip3 show mkdocs-material &> /dev/null || {
    echo "Installing mkdocs-material..."
    pip3 install mkdocs-material
}

pip3 show yamllint &> /dev/null || {
    echo "Installing yamllint..."
    pip3 install yamllint
}

# 1. Lint YAML files
echo ""
echo "1️⃣  Linting YAML files..."
if yamllint -d "{extends: default, rules: {line-length: {max: 120}, document-start: disable}}" mkdocs.yml 2>&1; then
    print_status 0 "YAML linting passed"
else
    print_status 1 "YAML linting failed"
    exit 1
fi

# 2. Build documentation in strict mode
echo ""
echo "2️⃣  Building documentation (strict mode)..."
if mkdocs build --strict --clean 2>&1; then
    print_status 0 "Documentation build passed"
else
    print_status 1 "Documentation build failed"
    exit 1
fi

# 3. Check for broken internal links
echo ""
echo "3️⃣  Checking for broken internal links..."
broken_links=0
while IFS=: read -r file link; do
    target=$(echo "$link" | sed -n 's/.*(\(.*\)).*/\1/p')
    if [ ! -z "$target" ] && [[ "$target" != http* ]] && [[ "$target" != "#"* ]]; then
        if [ ! -f "docs/$target" ] && [ ! -f "$target" ]; then
            echo -e "${YELLOW}⚠️  Potentially broken link in $file: $target${NC}"
            broken_links=$((broken_links + 1))
        fi
    fi
done < <(find docs -name "*.md" -type f -exec grep -H '\[.*\](.*)' {} \; 2>/dev/null | grep -v 'http')

if [ $broken_links -eq 0 ]; then
    print_status 0 "No broken internal links found"
else
    echo -e "${YELLOW}⚠️  Found $broken_links potentially broken link(s)${NC}"
fi

# 4. Check for TODO/FIXME comments
echo ""
echo "4️⃣  Checking for TODO/FIXME comments..."
if grep -r "TODO\|FIXME" docs/ &> /dev/null; then
    echo -e "${YELLOW}⚠️  Found TODO/FIXME comments in docs:${NC}"
    grep -rn "TODO\|FIXME" docs/ | head -5
    echo -e "${YELLOW}(This is a warning, not blocking commit)${NC}"
else
    print_status 0 "No TODO/FIXME comments found"
fi

# 5. Validate build artifacts
echo ""
echo "5️⃣  Validating build artifacts..."
if [ -f site/index.html ]; then
    print_status 0 "Build artifacts validated"
else
    print_status 1 "index.html not found in site/"
    exit 1
fi

# Clean up build artifacts
rm -rf site/

echo ""
echo -e "${GREEN}✅ All pre-commit checks passed!${NC}"
echo ""
